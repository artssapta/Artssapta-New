---
const { name, role, description, image } = Astro.props;

const resolvePath = (path: string) => {
  if (path && path.startsWith('/')) {
    const base = import.meta.env.BASE_URL;
    const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
    return `${cleanBase}${path}`;
  }
  return path;
};
---
<div class="team-row reveal">
    <div class="team-img">
        <img src={resolvePath(image)} alt={name} />
    </div>
    <div class="team-info">
        <h3>{name}</h3>
        {role && <p class="team-role">{role}</p>}
        <p class="team-desc">{description}</p>
    </div>
</div>

<style>
    .team-row {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        align-items: start;
        margin-top: 30px;
        padding-top: 30px;
        border-top: 1px solid rgba(0,0,0,0.08);
    }

    .team-img img {
        width: 100%;
        border-radius: 2px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: block;
    }

    .team-info h3 {
        font-family: 'Lora', serif;
        font-size: 19pt;
        color: #226E93;
        margin-bottom: 4px;
        font-weight: 400;
        line-height: 1.4;
        margin-top: 20px;
    }

    .team-role {
        font-family: 'Lora', serif;
        font-size: 15pt;
        font-style: italic;
        color: rgba(33,33,33,1);
        font-weight: 400;
        line-height: 1.25;
        margin-top: 8px;
        margin-bottom: 12px;
    }

    .team-desc {
        font-family: 'Gentium Basic', serif;
        font-size: 11pt;
        line-height: 1.6667;
        color: rgba(33, 33, 33, 1);
    }

    @media (max-width: 768px) {
        .team-row {
            grid-template-columns: 1fr;
        }
        .team-img { max-width: 240px; }
        .team-info h3 { font-size: 16pt; }
    }
</style>
