---
const { title, text, image, imageSide = "right" } = Astro.props;
---
<div class="container">
    <div class={`about-grid ${imageSide}`}>
        <div class="about-text">
            <h2 class="section-title">{title}</h2>
            <p>{text}</p>
        </div>
        <div class="about-img">
            <img src={image} alt={title} />
        </div>
    </div>
</div>

<style>
    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; margin-bottom: 60px; }
    .section-title { 
        font-family: 'Playfair Display', serif; 
        font-size: 2.8rem; 
        color: #2A7396; 
        text-align: left; 
        margin-bottom: 25px; 
        font-weight: 700;
    }
    .about-grid { 
        display: grid; 
        grid-template-columns: 1.2fr 1fr; 
        gap: 60px; 
        align-items: center; 
    }
    .about-grid.left { direction: rtl; }
    .about-grid.left .about-text { direction: ltr; }
    .about-text { 
        font-family: 'Lora', serif;
        font-size: 1.2rem; 
        line-height: 1.8;
        color: #333333;
        text-align: left; 
    }
    .about-img img { 
        width: 100%; 
        aspect-ratio: 1 / 1;
        object-fit: cover;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
</style>
