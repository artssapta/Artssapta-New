---
const { title, text, image, imageSide = "right" } = Astro.props;
---
<div class="about-section">
    <div class={`about-grid ${imageSide === 'left' ? 'image-left' : 'image-right'}`}>
        {imageSide === 'left' && (
            <div class="about-img reveal reveal-left">
                <img src={image} alt={title} />
            </div>
        )}
        <div class="about-text reveal reveal-right">
            <h2 class="section-title">{title}</h2>
            <p>{text}</p>
        </div>
        {imageSide !== 'left' && (
            <div class="about-img reveal reveal-right">
                <img src={image} alt={title} />
            </div>
        )}
    </div>
</div>

<style>
    .about-section {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 48px;
    }

    .section-title {
        font-family: 'Lora', serif;
        font-size: 34pt;
        color: #226E93;
        text-align: left;
        margin-bottom: 20px;
        margin-top: 30px;
        font-weight: 400;
        letter-spacing: normal;
        line-height: 1.2;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 50px;
        align-items: center;
    }

    .about-grid.image-left {
        grid-template-columns: 1fr 1.2fr;
    }

    .about-text {
        font-family: 'Gentium Basic', serif;
        font-size: 11pt;
        line-height: 1.6667;
        color: rgba(33, 33, 33, 1);
        text-align: left;
    }

    .about-img img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    @media (max-width: 768px) {
        .about-grid {
            grid-template-columns: 1fr;
        }
        .about-section {
            padding: 30px 24px;
        }
        .section-title {
            font-size: 24pt;
        }
    }
</style>
