---
const { title, text, image, imageSide = "right" } = Astro.props;
---
<div class="container">
    <div class={`about-grid ${imageSide}`}>
        <div class="about-text reveal reveal-left">
            <h2 class="section-title">{title}</h2>
            <p>{text}</p>
        </div>
        <div class="about-img reveal reveal-right">
            <img src={image} alt={title} />
        </div>
    </div>
</div>

<style>
    .container { max-width: 1000px; margin: 0 auto; padding: 0 20px; margin-bottom: 40px; }
    .section-title { 
        font-family: 'Lora', serif; 
        font-size: 2.2rem; 
        color: #1e6c93; 
        text-align: left; 
        margin-bottom: 20px; 
        font-weight: 400;
    }
    .about-grid { 
        display: grid; 
        grid-template-columns: 1.2fr 1fr; 
        gap: 50px; 
        align-items: center; 
    }
    .about-grid.left { direction: rtl; }
    .about-grid.left .about-text { direction: ltr; }
    .about-text { 
        font-family: 'Gentium Basic', serif;
        font-size: 1.15rem; 
        line-height: 1.6667;
        color: #212121;
        text-align: left; 
    }
    .about-img img { 
        width: 100%; 
        aspect-ratio: 1 / 1;
        object-fit: cover;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
</style>
