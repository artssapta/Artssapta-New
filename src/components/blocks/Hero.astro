---
const { title, subtitle, color = "#226E93" } = Astro.props;
---
<section class="hero" style={`background-color: ${color};`}>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>{title}</h1>
        {subtitle && <p>{subtitle}</p>}
    </div>
</section>

<style>
    .hero {
        position: relative;
        height: 340px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
        margin-bottom: 0;
        overflow: hidden;
        padding-top: 66px; /* Space for sticky nav */
    }

    /* Subtle dark overlay like Google Sites (opacity: 0.4) */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(33, 33, 33, 0.4);
        z-index: 0;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        padding: 60px 48px;
    }

    .hero h1 {
        font-family: 'Lora', serif;
        font-size: 64pt;
        font-weight: 400;
        line-height: 1;
        letter-spacing: -1px;
        margin-top: 40px;
        margin-bottom: 0;
        color: white;
    }

    .hero p {
        font-family: 'Lora', serif;
        font-size: 25pt;
        font-weight: 400;
        line-height: 1.1;
        margin-top: 25px;
        color: white;
    }

    @media (max-width: 767px) {
        .hero h1 { font-size: 42pt; }
        .hero p { font-size: 19pt; }
    }
</style>
