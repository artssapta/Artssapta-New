---
const { title, subtitle, color = "#6091B0" } = Astro.props;
---
<section class="hero" style={`background-color: ${color}; background-image: url('/assets/hero_music_banner.png');`}>
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
</section>

<style>
    .hero { 
        height: 340px; 
        display: flex; 
        flex-direction: column; 
        justify-content: center; 
        align-items: center; 
        text-align: center; 
        color: white; 
        margin-bottom: 40px; 
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding-top: 90px; /* Space for absolute transparent header */
        box-sizing: border-box;
    }
    .hero h1 { 
        font-family: 'Lora', serif; 
        font-size: 5.3rem; 
        font-weight: 400;
        margin-bottom: 24px;
        letter-spacing: -0.5px;
    }
    .hero p {
        font-family: 'Lora', serif;
        font-size: 1.5rem;
        font-weight: 400;
        max-width: 900px;
        line-height: 1.3;
    }
</style>
