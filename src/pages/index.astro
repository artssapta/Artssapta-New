---
import { getEntry } from 'astro:content';
import Hero from '../components/blocks/Hero.astro';
import About from '../components/blocks/About.astro';
import Events from '../components/blocks/Events.astro';
import TeamGrid from '../components/blocks/TeamGrid.astro';
import GoogleForm from '../components/blocks/GoogleForm.astro';
import TextBlock from '../components/blocks/TextBlock.astro';
import YouTubeVideo from '../components/blocks/YouTubeVideo.astro';
import Gallery from '../components/blocks/Gallery.astro';

const homePage = await getEntry('pages', 'home');
const eventsPage = await getEntry('pages', 'events');
const feedbackPage = await getEntry('pages', 'feedback');
const regSpotlightPage = await getEntry('pages', 'reg-spotlight');
const regGroupPage = await getEntry('pages', 'reg-group');
const mediaPastPage = await getEntry('pages', 'media-past');
const mediaVideosPage = await getEntry('pages', 'media-videos');
const mediaChroniclesPage = await getEntry('pages', 'media-chronicles');

const homeBlocks = homePage?.data?.blocks || [];
const eventsBlocks = eventsPage?.data?.blocks || [];
const feedbackBlocks = feedbackPage?.data?.blocks || [];
const regSpotlightBlocks = regSpotlightPage?.data?.blocks || [];
const regGroupBlocks = regGroupPage?.data?.blocks || [];
const mediaPastBlocks = mediaPastPage?.data?.blocks || [];
const mediaVideosBlocks = mediaVideosPage?.data?.blocks || [];
const mediaChroniclesBlocks = mediaChroniclesPage?.data?.blocks || [];

const components = {
  hero: Hero,
  about: About,
  'team-grid': TeamGrid,
  text: TextBlock,
  youtube: YouTubeVideo,
  gallery: Gallery,
  events: Events,
  'google-form': GoogleForm,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SAPTA | Student Artists' Platform</title>
    <meta name="description" content="SAPTA is a non-profit, student-led organization that promotes Carnatic music. While providing students of all levels opportunities to perform, they also have a way to showcase their talents in unique ways.">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,700;1,400&family=Gentium+Basic:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --sapta-teal: #226E93;
            --sapta-teal-dark: #1e6c93;
            --nav-bg: #212121;
            --text-main: rgba(33,33,33,1);
            --font-serif: 'Gentium Basic', serif;
            --font-heading: 'Lora', serif;
            --nav-width: 250px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font-serif);
            background: #ffffff;
            color: var(--text-main);
            line-height: 1.6667;
            /* Layout: side nav + content */
            display: flex;
            min-height: 100vh;
        }

        /* ===================== */
        /* SIDE NAVIGATION       */
        /* ===================== */
        .side-nav {
            width: var(--nav-width);
            min-height: 100vh;
            background-color: var(--nav-bg);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        /* Logo area */
        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 16px 16px;
            cursor: pointer;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .nav-logo img {
            height: 36px;
            border-radius: 3px;
        }
        .nav-logo span {
            font-family: var(--font-heading);
            font-size: 15pt;
            color: rgba(255,255,255,1);
            font-weight: 400;
            letter-spacing: 1px;
            line-height: 1.3;
        }

        /* Nav items */
        .nav-items {
            list-style: none;
            padding: 0;
            flex: 1;
        }

        .nav-item {
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .nav-item > .nav-link {
            display: block;
            padding: 11.5px 16px;
            color: rgba(255,255,255,0.87);
            font-family: var(--font-heading);
            font-size: 12pt;
            font-weight: 400;
            cursor: pointer;
            transition: color 0.2s, background 0.2s;
            line-height: 1.333;
            text-decoration: none;
        }
        .nav-item > .nav-link:hover,
        .nav-item > .nav-link.active {
            color: rgba(73, 170, 212, 1);
            background: rgba(255,255,255,0.05);
        }

        /* Dropdown group */
        .nav-group-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 11.5px 16px;
            color: rgba(255,255,255,0.87);
            font-family: var(--font-heading);
            font-size: 12pt;
            font-weight: 400;
            cursor: pointer;
            line-height: 1.333;
            transition: color 0.2s, background 0.2s;
            user-select: none;
        }
        .nav-group-label:hover {
            color: rgba(73, 170, 212, 1);
            background: rgba(255,255,255,0.05);
        }
        .nav-group-label .chevron {
            font-size: 0.7em;
            transition: transform 0.25s;
        }
        .nav-group.open .nav-group-label .chevron {
            transform: rotate(180deg);
        }

        .nav-sub {
            list-style: none;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(0,0,0,0.2);
        }
        .nav-group.open .nav-sub {
            max-height: 300px;
        }
        .nav-sub li {
            padding: 8px 8px 8px 32px;
            color: rgba(73, 170, 212, 1);
            font-family: var(--font-heading);
            font-size: 11pt;
            cursor: pointer;
            line-height: 1.333;
            transition: color 0.2s, background 0.2s;
        }
        .nav-sub li:hover {
            color: rgba(255,255,255,1);
            background: rgba(255,255,255,0.05);
        }

        /* ===================== */
        /* MAIN CONTENT          */
        /* ===================== */
        .main-content {
            margin-left: var(--nav-width);
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Tab content */
        .tab-content { display: none; flex: 1; animation: fadeIn 0.35s ease; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

        /* ===================== */
        /* SCROLL REVEALS        */
        /* ===================== */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1), transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .reveal-left { transform: translateX(-36px); }
        .reveal-right { transform: translateX(36px); }
        .reveal.visible { opacity: 1; transform: translate(0); }

        /* ===================== */
        /* WHITE CONTENT AREA    */
        /* ===================== */
        .page-body {
            background-color: #ffffff;
        }

        /* ===================== */
        /* FOOTER                */
        /* ===================== */
        footer {
            background-color: var(--nav-bg);
            color: rgba(255,255,255,0.87);
            padding: 32px 48px;
            font-family: var(--font-heading);
            font-size: 12pt;
        }
        footer h3 {
            font-size: 15pt;
            font-weight: 400;
            margin-bottom: 8px;
            color: rgba(73, 170, 212, 1);
        }
        footer p {
            font-family: var(--font-serif);
            font-size: 11pt;
            color: rgba(255,255,255,0.6);
        }

        /* ===================== */
        /* RESPONSIVE            */
        /* ===================== */
        @media (max-width: 900px) {
            :root { --nav-width: 0px; }
            .side-nav { display: none; }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>

    <!-- SIDE NAVIGATION -->
    <nav class="side-nav" id="sideNav">
        <div class="nav-logo" onclick="showTab('home')">
            <img src="/assets/image_186b79.png" alt="SAPTA Logo">
            <span>SAPTA</span>
        </div>
        <ul class="nav-items">
            <li class="nav-item">
                <span class="nav-link active" id="nav-home" onclick="showTab('home')">About Us</span>
            </li>
            <li class="nav-item">
                <span class="nav-link" id="nav-events" onclick="showTab('events')">Events</span>
            </li>
            <li class="nav-item">
                <span class="nav-link" id="nav-feedback" onclick="showTab('feedback')">Feedback Form</span>
            </li>
            <li class="nav-item nav-group" id="group-reg">
                <div class="nav-group-label" onclick="toggleGroup('group-reg')">
                    Registration <span class="chevron">▾</span>
                </div>
                <ul class="nav-sub">
                    <li onclick="showTab('reg-spotlight')">Sapta Spotlight</li>
                    <li onclick="showTab('reg-group')">Group Registration</li>
                </ul>
            </li>
            <li class="nav-item nav-group" id="group-media">
                <div class="nav-group-label" onclick="toggleGroup('group-media')">
                    Media <span class="chevron">▾</span>
                </div>
                <ul class="nav-sub">
                    <li onclick="showTab('media-past')">Past Events</li>
                    <li onclick="showTab('media-videos')">Videos / Performances</li>
                    <li onclick="showTab('media-chronicles')">Chronicles</li>
                </ul>
            </li>
        </ul>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="main-content">

        <main id="home" class="tab-content active page-body">
            {homeBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </main>

        <section id="events" class="tab-content page-body">
            {eventsBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </section>

        <section id="feedback" class="tab-content page-body">
            {feedbackBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </section>

        <section id="reg-spotlight" class="tab-content page-body">
            {regSpotlightBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </section>

        <section id="reg-group" class="tab-content page-body">
            {regGroupBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </section>

        <section id="media-past" class="tab-content page-body">
            {mediaPastBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </section>

        <section id="media-videos" class="tab-content page-body">
            {mediaVideosBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </section>

        <section id="media-chronicles" class="tab-content page-body">
            {mediaChroniclesBlocks.map((block) => {
                const Component = components[block.type];
                return Component ? <Component {...block} /> : null;
            })}
        </section>

        <footer>
            <h3>Contact Us</h3>
            <p>Email: artssapta@gmail.com</p>
        </footer>
    </div>

    <script is:inline>
        // --- Tab Navigation ---
        const NAV_LINKS = ['home', 'events', 'feedback'];

        function showTab(tabId) {
            // Hide all
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            // Show target
            const target = document.getElementById(tabId);
            if (target) target.classList.add('active');

            // Update active nav link for top-level items
            document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
            const navLink = document.getElementById('nav-' + tabId);
            if (navLink) navLink.classList.add('active');

            // Re-init scroll reveals
            setTimeout(initScrollReveal, 60);
            window.scrollTo(0, 0);
        }

        // --- Group toggles ---
        function toggleGroup(groupId) {
            const group = document.getElementById(groupId);
            if (group) group.classList.toggle('open');
        }

        // --- Scroll Reveal ---
        function initScrollReveal() {
            const reveals = document.querySelectorAll('.reveal:not(.visible)');
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.04, rootMargin: '0px 0px -30px 0px' });

            reveals.forEach(el => observer.observe(el));
        }

        document.addEventListener('DOMContentLoaded', () => {
            initScrollReveal();
        });
    </script>
</body>
</html>
